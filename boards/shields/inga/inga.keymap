// This file was generated from a template. Edit it to match your keyboard.
// See https://zmk.dev/docs/development/hardware-integration/new-shield for more instructions.

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <behaviors/rgbled_widget.dtsi>

// Macros
#define KEYS_L 0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 30 31
#define KEYS_R 5 6 7 8 9 15 16 17 18 19 25 26 27 28 29 32 33
#define KEYS_T 30 31 32 33


/ {
    combos {
        compatible = "zmk,combos";
	combo_gui {
            timeout-ms = <100>;
	    key-positions = <31 32>;
	    bindings = <&kp RGUI>;
	};
	combo_battery {
            timeout-ms = <100>;
	    key-positions = <30 31>;
	    bindings = <&ind_bat>;
	};
	combo_esc_left {
            timeout-ms = <100>;
	    key-positions = <22 23>;
	    bindings = <&kp ESC>;
	};
	combo_esc_right {
            timeout-ms = <100>;
	    key-positions = <26 27>;
	    bindings = <&kp ESC>;
	};
	combo_ctrl_left {
            timeout-ms = <100>;
	    key-positions = <12 13>;
	    bindings = <&kp LCTRL>;
	};
	combo_ctrl_right {
            timeout-ms = <100>;
	    key-positions = <16 17>;
	    bindings = <&kp RCTRL>;
	};
	combo_shift_left {
            timeout-ms = <100>;
	    key-positions = <11 12>;
	    bindings = <&kp LSHFT>;
	};
	combo_shift_right {
            timeout-ms = <100>;
	    key-positions = <17 18>;
	    bindings = <&kp RSHFT>;
	};
	combo_alt_left {
            timeout-ms = <100>;
	    key-positions = <21 22>;
	    bindings = <&kp LALT>;
	};
	combo_alt_right {
            timeout-ms = <100>;
	    key-positions = <27 28>;
	    bindings = <&kp RALT>;
	};
    };

    keymap {
        compatible = "zmk,keymap";

	// Layer 0
        default_layer {
            bindings = <
		// ┌───────┬───────┬───────┬─────────┬─────────┐   ┌───────┬──────────┬─────────┬───────┬────────┐  
		// │   q   │   w   │   e   │    r    │    t    │   │   y   │     u    │    i    │   o   │    p   │
		     &kp Q   &kp W   &kp E    &kp R     &kp T        &kp Y     &kp U     &kp I    &kp O   &kp P
		// ├───────┼───────┼───────┼─────────┼─────────┤   ├───────┼──────────┼─────────┼───────┼────────┤ 
		// │   a   │   s   │   d   │    f    │    g    │   │   h   │     j    │    k    │   l   │    ;   │
		     &kp A   &kp S   &kp D    &kp F     &kp G        &kp H     &kp J     &kp K    &kp L  &kp SEMI
		// ├───────┼───────┼───────┼─────────┼─────────┤   ├───────┼──────────┼─────────┼───────┼────────┤ 
		// │   z   │   x   │   c   │    v    │    b    │   │   n   │     m    │    ,    │   .   │    /   │
		     &kp Z   &kp X   &kp C    &kp V     &kp B        &kp N     &kp M   &kp COMMA &kp DOT &kp FSLH
		// └───────┴───────┴───────┼─────────┼─────────┤   ├───────┼──────────┼─────────┴───────┴────────┘
		//                         │   tab   │  space  │   │ enter │   bksp   │                        
		                            &lt 1 TAB &kp SPACE     &kp RET &lt 1 BSPC
		//                         └─────────┴─────────┘   └───────┴──────────┘
            >;
        };
	
	
	// Layer 1 
	num_pun_layer {
            bindings = <
		// ┌──────┬─────────┬─────────┬─────────┬──────┐   ┌──────┬───────┬───────┬───────┬──────┐  
		// │      │    `    │    -    │    =    │      │   │      │   7   │   8   │   9   │      │
		    &trans &kp GRAVE &kp MINUS &kp EQUAL &trans     &trans  &kp N7  &kp N8  &kp N9 &trans
		// ├──────┼─────────┼─────────┼─────────┼──────┤   ├──────┼───────┼───────┼───────┼──────┤ 
		// │      │         │    '    │         │      │   │      │   4   │   5   │   6   │      │
		    &trans   &trans   &kp SQT    &trans  &trans     &trans  &kp N4  &kp N5  &kp N6 &trans 
		// ├──────┼─────────┼─────────┼─────────┼──────┤   ├──────┼───────┼───────┼───────┼──────┤ 
		// │      │    [    │    ]    │    \    │      │   │  0   │   1   │   2   │   3   │      │
		    &trans &kp LBKT  &kp RBKT  &kp BSLH  &trans     &kp N0  &kp N1  &kp N2  &kp N3 &trans  
		// └──────┴─────────┴─────────┼─────────┼──────┤   ├──────┼───────┼───────┴───────┴──────┘
		//                            │         │      │   │      │       │                        
		                                &trans   &trans     &trans  &trans  
		//                            └─────────┴──────┘   └──────┴───────┘
            >;
	};
    };
};
