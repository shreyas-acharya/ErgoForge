// This file was generated from a template. Edit it to match your keyboard.
// See https://zmk.dev/docs/development/hardware-integration/new-shield for more instructions.

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

// Macros
#define KEYS_L 0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 30 31
#define KEYS_R 5 6 7 8 9 15 16 17 18 19 25 26 27 28 29 32 33
#define KEYS_T 30 31 32 33
#define HRML(k1, k2, k3, k4) &hrml LGUI k1  &hrml LALT k2  &hrml LSHFT k3 &hrml LCTRL k4
#define HRMR(k1, k2, k3, k4) &hrmr RCTRL k1  &hrmr RSHFT k2  &hrmr RALT k3 &hrmr RGUI k4

/ {
    behaviour {
        hrml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_R KEYS_T>;
            hold-trigger-on-release;
        };
        hrmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_L KEYS_T>;
            hold-trigger-on-release;
        };
    };
    keymap {
        compatible = "zmk,keymap";

	// Layer 0
        default_layer {
            bindings = <
		// ┌───────┬───────┬───────┬───────┬───────┐   ┌───────┬───────┬───────┬───────┬───────┐  
		// │   q   │   w   │   e   │   r   │   t   │   │   y   │   u   │   i   │   o   │   p   │
		     &kp Q   &kp W   &kp E   &kp R   &kp T       &kp Y   &kp U   &kp I   &kp O   &kp P
		// ├───────┼───────┼───────┼───────┼───────┤   ├───────┼───────┼───────┼───────┼───────┤ 
		// │   a   │   s   │   d   │   f   │   g   │   │   h   │   j   │   k   │   l   │   ;   │
		    HRML(A,    S,      D,      F)    &kp G       &kp H  HRMR(J,    K,      L,   SEMI)
		// ├───────┼───────┼───────┼───────┼───────┤   ├───────┼───────┼───────┼───────┼───────┤ 
		// │   z   │   x   │   c   │   v   │   b   │   │   n   │   m   │   ,   │   .   │   /   │
		     &kp Z   &kp X   &kp C   &kp V   &kp B       &kp N   &kp M   &kp COMMA &kp DOT &kp FSLH
		// └───────┴───────┴───────┼───────┼───────┤   ├───────┼───────┼───────┴───────┴───────┘
		//                         │  tab  │ space │   │ enter │ bksp  │                        
		                            &kp TAB &kp SPACE   &kp RET &kp BSPC
		//                         └───────┴───────┘   └───────┴───────┘
            >;
        };
    };
};
